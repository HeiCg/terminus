{
  "name": "@terminus/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "terminus": "dist/cli/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/src/cli.js",
